+// Apps may not bind ports below 1024 on Android, and the guest binds its VDP socket to port 1000.
+constexpr uint16_t kFirstUnprivilegedPort = 1024;
+constexpr uint16_t kPrivilegedPortShift = 30000;
+constexpr uint32_t kGuestSolSocket = 0xFFFF;
+
+uint16_t HostBindPort(uint16_t guest_port) {
+  if (guest_port == 0 || guest_port >= kFirstUnprivilegedPort) {
+    return guest_port;
+  }
+  return static_cast<uint16_t>(guest_port + kPrivilegedPortShift);
+}
+
+void LogShiftedPortOnce(uint16_t guest_port, uint16_t host_port) {
+  static std::atomic<bool> logged{false};
+  if (guest_port != host_port && !logged.exchange(true)) {
+    REXLOG_INFO("XSocket: guest port {} bound as host port {} (Android reserves ports below {})",
+                guest_port, host_port, kFirstUnprivilegedPort);
+  }
+}
+
+// The guest numbers SOL_SOCKET and its options the Winsock way; Linux numbers them differently.
+// Options without a Linux twin keep the guest's numbers and fail as before.
+void TranslateSocketOption(uint32_t& level, uint32_t& optname) {
+  if (level != kGuestSolSocket) {
+    return;
+  }
+  switch (optname) {
+    case 0x0004:
+      optname = SO_REUSEADDR;
+      break;
+    case 0x0008:
+      optname = SO_KEEPALIVE;
+      break;
+    case 0x0020:
+      optname = SO_BROADCAST;
+      break;
+    case 0x0100:
+      optname = SO_OOBINLINE;
+      break;
+    case 0x1001:
+      optname = SO_SNDBUF;
+      break;
+    case 0x1002:
+      optname = SO_RCVBUF;
+      break;
+    default:
+      return;
+  }
+  level = SOL_SOCKET;
+}
+
+// Winsock's FIONBIO and FIONREAD with a big-endian u_long; Linux numbers both differently and
+// takes a host int, so the guest's non-blocking request never reached the socket and the main
+// thread blocked in its first recvfrom.
+constexpr uint32_t kGuestFionbio = 0x8004667E;
+constexpr uint32_t kGuestFionread = 0x4004667F;
+
+int SetNonBlocking(int fd, const uint8_t* guest_arg) {
+  int enable = memory::load_and_swap<uint32_t>(guest_arg) != 0 ? 1 : 0;
+  return ioctl(fd, FIONBIO, &enable);
+}
+
+int ReadAvailableBytes(int fd, uint8_t* guest_arg) {
+  int available = 0;
+  const int ret = ioctl(fd, FIONREAD, &available);
+  if (ret == 0) {
+    memory::store_and_swap<uint32_t>(guest_arg, static_cast<uint32_t>(available));
+  }
+  return ret;
+}
+
+int GuestSocketIoctl(uint64_t handle, uint32_t cmd, uint8_t* arg) {
+  const int fd = static_cast<int>(handle);
+  if (cmd == kGuestFionbio) {
+    return SetNonBlocking(fd, arg);
+  }
+  if (cmd == kGuestFionread) {
+    return ReadAvailableBytes(fd, arg);
+  }
+  return rex::net::socket_ioctl(handle, cmd, arg);
+}
