diff --git a/thirdparty/ffmpeg-android/aarch64_stubs.c b/thirdparty/ffmpeg-android/aarch64_stubs.c
new file mode 100644
index 0000000..20965ec
--- /dev/null
+++ b/thirdparty/ffmpeg-android/aarch64_stubs.c
@@ -0,0 +1,32 @@
+/*
+ * Android-only (arm64) link stubs for the bundled FFmpeg.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * Copyright (c) 2026 Santiago Quiroz Upegui and the gow2-recomp contributors
+ *
+ * On Android the aarch64 assembly sources are not built (pure C fallback; see
+ * thirdparty/CMakeLists.txt) and ffmpeg-android/config.h sets ARCH_AARCH64=0, so the generic C
+ * code is used. These no-op definitions of the ff_*_init_aarch64() entry points remain for
+ * unoptimized builds, where an `if (0)`-guarded call in float_dsp.c, fft_template.c or
+ * mpegaudiodsp.c may still emit a reference. Only added to the build when ANDROID is set.
+ */
+#if defined(__ANDROID__) && defined(__aarch64__)
+
+#include "libavutil/attributes.h"
+#include "libavutil/float_dsp.h"
+#include "libavcodec/fft.h"
+#include "libavcodec/mpegaudiodsp.h"
+
+av_cold void ff_float_dsp_init_aarch64(AVFloatDSPContext* fdsp) {
+  (void)fdsp;
+}
+
+av_cold void ff_fft_init_aarch64(FFTContext* s) {
+  (void)s;
+}
+
+av_cold void ff_mpadsp_init_aarch64(MPADSPContext* s) {
+  (void)s;
+}
+
+#endif  // defined(__ANDROID__) && defined(__aarch64__)
diff --git a/thirdparty/ffmpeg-android/config.h b/thirdparty/ffmpeg-android/config.h
new file mode 100644
index 0000000..c144846
--- /dev/null
+++ b/thirdparty/ffmpeg-android/config.h
@@ -0,0 +1,45 @@
+/*
+ * FFmpeg configuration for the Android arm64 build of the ReXGlue runtime.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * Copyright (c) 2026 Santiago Quiroz Upegui and the gow2-recomp contributors
+ *
+ * Android only: thirdparty/CMakeLists.txt puts this folder ahead of thirdparty/FFmpeg on the
+ * include path of libavutil and libavcodec, so FFmpeg's `#include "config.h"` finds this file.
+ * It takes FFmpeg's own Android aarch64 configuration and turns the aarch64 assembly paths off:
+ * the .S sources are not built on Android, so the generic C code must be selected.
+ */
+#ifndef REX_FFMPEG_ANDROID_CONFIG_H
+#define REX_FFMPEG_ANDROID_CONFIG_H
+
+#if !defined(__ANDROID__) || !defined(__aarch64__)
+#error "thirdparty/ffmpeg-android/config.h is only for Android arm64 builds"
+#endif
+
+#include "config_android_aarch64.h"
+
+#undef ARCH_AARCH64
+#define ARCH_AARCH64 0
+
+#undef HAVE_ARMV8
+#define HAVE_ARMV8 0
+#undef HAVE_NEON
+#define HAVE_NEON 0
+#undef HAVE_VFP
+#define HAVE_VFP 0
+
+#undef HAVE_ARMV8_EXTERNAL
+#define HAVE_ARMV8_EXTERNAL 0
+#undef HAVE_NEON_EXTERNAL
+#define HAVE_NEON_EXTERNAL 0
+#undef HAVE_VFP_EXTERNAL
+#define HAVE_VFP_EXTERNAL 0
+
+#undef HAVE_ARMV8_INLINE
+#define HAVE_ARMV8_INLINE 0
+#undef HAVE_NEON_INLINE
+#define HAVE_NEON_INLINE 0
+#undef HAVE_VFP_INLINE
+#define HAVE_VFP_INLINE 0
+
+#endif  // REX_FFMPEG_ANDROID_CONFIG_H
