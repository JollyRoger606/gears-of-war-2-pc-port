+
+__attribute__((naked)) static void FiberSwitchImpl(AndroidFiberContext* from,
+                                                   AndroidFiberContext* to) {
+  __asm__ volatile(
+      // Save callee-saved state into *from (x0).
+      "stp x19, x20, [x0, #8]\n"
+      "stp x21, x22, [x0, #24]\n"
+      "stp x23, x24, [x0, #40]\n"
+      "stp x25, x26, [x0, #56]\n"
+      "stp x27, x28, [x0, #72]\n"
+      "stp x29, x30, [x0, #88]\n"
+      "mov x2, sp\n"
+      "str x2, [x0, #104]\n"
+      "stp d8, d9, [x0, #112]\n"
+      "stp d10, d11, [x0, #128]\n"
+      "stp d12, d13, [x0, #144]\n"
+      "stp d14, d15, [x0, #160]\n"
+      // Restore callee-saved state from *to (x1).
+      "ldp x19, x20, [x1, #8]\n"
+      "ldp x21, x22, [x1, #24]\n"
+      "ldp x23, x24, [x1, #40]\n"
+      "ldp x25, x26, [x1, #56]\n"
+      "ldp x27, x28, [x1, #72]\n"
+      "ldp d8, d9, [x1, #112]\n"
+      "ldp d10, d11, [x1, #128]\n"
+      "ldp d12, d13, [x1, #144]\n"
+      "ldp d14, d15, [x1, #160]\n"
+      "ldr x2, [x1, #104]\n"
+      "mov sp, x2\n"
+      "ldp x29, x30, [x1, #88]\n"
+      "ldr x0, [x1]\n"
+      "ret\n");
