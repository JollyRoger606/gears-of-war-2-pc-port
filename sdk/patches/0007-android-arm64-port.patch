+      "TEXFAIL {} (guest format {}) {} {}x{} signed_separate {} scaled_resolve {}: the texture "
+      "data could not be loaded (logged once per format)",
+      format_info ? format_info->name : "?", uint32_t(info.format), info.dimension_name,
