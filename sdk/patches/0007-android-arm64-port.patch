+uint32_t AndroidTextureFailureKey(const AndroidTextureLogInfo& info) {
+  return uint32_t(info.format) | (info.dimension << 6) | (uint32_t(info.scaled_resolve) << 8) |
+         (uint32_t(info.signed_separate) << 9);
