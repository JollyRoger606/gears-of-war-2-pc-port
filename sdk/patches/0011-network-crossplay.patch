+std::vector<Endpoint> ResolvePeerList(std::string_view text, bool allow_dns) {
+  std::vector<Endpoint> peers;
+  for (const HostPort& host_port : ParseHostPortList(text)) {
+    for (uint32_t ip : ResolveHost(host_port.host, allow_dns)) {
+      peers.push_back({ip, host_port.port});
+    }
+  }
+  return peers;
+}
+
+std::vector<Subnet> ResolveAllowList(std::string_view text, bool allow_dns) {
+  std::vector<Subnet> allowed;
+  for (std::string_view token : SplitListTokens(text)) {
+    if (auto subnet = ParseIpv4Cidr(token, kHostPrefixLength)) {
+      allowed.push_back(*subnet);
+      continue;
+    }
+    auto host_port = ParseHostPort(token);
+    if (!host_port) {
+      WarnOnce(fmt::format("net_allow_peers entry '{}' is not an address, range or host name; "
+                           "ignored",
+                           token));
+      continue;
+    }
+    for (uint32_t ip : ResolveHost(host_port->host, allow_dns)) {
+      allowed.push_back({ip, kHostPrefixLength});
+    }
+  }
+  return allowed;
+}
