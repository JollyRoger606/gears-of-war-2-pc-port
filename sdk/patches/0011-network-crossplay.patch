+std::vector<std::string> DnsNames(std::string_view peers, std::string_view allowed,
+                                  std::string_view public_address) {
+  std::vector<std::string> names;
+  CollectPeerNames(peers, names);
+  CollectAllowNames(allowed, names);
+  CollectPublicName(public_address, names);
+  std::sort(names.begin(), names.end());
+  names.erase(std::unique(names.begin(), names.end()), names.end());
+  return names;
+}
