+std::vector<uint32_t> ResolveHost(const std::string& host, bool allow_dns) {
+  if (auto ip = ParseIpv4(host)) {
+    return {*ip};
+  }
+  if (!allow_dns) {
+    return {};
+  }
+#if REX_PLATFORM_WIN32
+  EnsureWinsockStarted();
+#endif
+  addrinfo hints{};
+  hints.ai_family = AF_INET;
+  hints.ai_socktype = SOCK_DGRAM;
+  addrinfo* results = nullptr;
+  if (getaddrinfo(host.c_str(), nullptr, &hints, &results) != 0) {
+    WarnOnce(fmt::format("[netlink] cannot resolve {}", host));
+    return {};
+  }
+  std::vector<uint32_t> ips;
+  for (addrinfo* node = results; node != nullptr; node = node->ai_next) {
+    if (node->ai_family != AF_INET || node->ai_addr == nullptr) {
+      continue;
+    }
+    auto* addr = reinterpret_cast<sockaddr_in*>(node->ai_addr);
+    AppendUniqueIp(ips, ntohl(addr->sin_addr.s_addr));
+  }
+  freeaddrinfo(results);
+  return ips;
+}
