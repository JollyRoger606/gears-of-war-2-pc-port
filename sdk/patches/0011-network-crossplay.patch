+void CollectAllowNames(std::string_view text, std::vector<std::string>& names) {
+  for (std::string_view token : SplitListTokens(text)) {
+    if (ParseIpv4Cidr(token, kHostPrefixLength)) {
+      continue;
+    }
+    auto host_port = ParseHostPort(token);
+    if (host_port && !ParseIpv4(host_port->host)) {
+      names.push_back(host_port->host);
+    }
+  }
+}
