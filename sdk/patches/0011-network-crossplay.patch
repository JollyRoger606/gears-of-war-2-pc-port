+std::optional<Endpoint> ResolvePublicAddress(std::string_view text, bool allow_dns) {
+  auto host_port = ParseHostPort(text);
+  if (!host_port) {
+    return std::nullopt;
+  }
+  std::vector<uint32_t> ips = ResolveHost(host_port->host, allow_dns);
+  if (ips.empty()) {
+    return std::nullopt;
+  }
+  return Endpoint{ips.front(), host_port->port};
