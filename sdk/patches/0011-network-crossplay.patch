+std::string FormatResolvedIps(const std::vector<uint32_t>& ips) {
+  if (ips.empty()) {
+    return "nothing";
+  }
+  std::string list;
+  for (uint32_t ip : ips) {
+    list += (list.empty() ? "" : ", ") + FormatIpv4(ip);
+  }
+  return list;
+}
+
+void ResolveOnce(bool allow_dns) {
+  std::string peers_text = REXCVAR_GET(net_peers);
+  std::string allow_text = REXCVAR_GET(net_allow_peers);
+  std::string public_text = REXCVAR_GET(net_public_address);
+  std::vector<Endpoint> peers = ResolvePeerList(peers_text, allow_dns);
+  std::vector<Subnet> allowed = ResolveAllowList(allow_text, allow_dns);
+  std::optional<Endpoint> public_address = ResolvePublicAddress(public_text, allow_dns);
+  std::map<std::string, std::vector<uint32_t>> results;
+  for (const std::string& name : DnsNames(peers_text, allow_text, public_text)) {
+    results[name] = ResolveHost(name, allow_dns);
+  }
+  bool trace = TraceEnabled();
+  std::lock_guard lock(Resolver().mutex);
+  static bool stored = false;
+  bool store = allow_dns || !stored;
+  for (const auto& [name, ips] : results) {
+    std::vector<uint32_t>& previous = Resolver().last_results[name];
+    if (trace || previous != ips) {
+      REXLOG_INFO("[netlink] resolved {} -> {}", name, FormatResolvedIps(ips));
+    }
+    if (store) {
+      previous = ips;
+    }
+  }
+  if (store) {
+    Resolver().peers = std::move(peers);
+    Resolver().allowed = std::move(allowed);
+    Resolver().public_address = public_address;
+    stored = true;
+  }
+}
+
+bool HasDnsNames() {
+  std::string peers = REXCVAR_GET(net_peers);
+  std::string allowed = REXCVAR_GET(net_allow_peers);
+  std::string public_address = REXCVAR_GET(net_public_address);
+  return !DnsNames(peers, allowed, public_address).empty();
+}
+
+void ResolverLoop() {
+  ResolveOnce(true);
+  for (;;) {
+    std::unique_lock lock(Resolver().mutex);
+    Resolver().wake.wait_for(lock, std::chrono::milliseconds(kPeerResolveIntervalMs));
+    lock.unlock();
+    ResolveOnce(true);
+  }
+}
