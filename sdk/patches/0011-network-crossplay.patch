+TEST_CASE("system_link: BuildXnAddr lays out online address fields", "[system][system_link]") {
+  MacAddress mac{0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE};
+
+  XnAddrBytes out =
+      BuildXnAddr(0xC0A80A72u /* 192.168.10.114 */, mac, 0x01020304u /* 1.2.3.4 */, 41000);
+  CHECK(out[0] == 0xC0);
+  CHECK(out[1] == 0xA8);
