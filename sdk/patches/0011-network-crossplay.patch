+std::optional<uint32_t> ProbeDefaultRouteIp() {
+  ProbeSocket sock = socket(AF_INET, SOCK_DGRAM, 0);
+  if (sock == kInvalidProbeSocket) {
+    return std::nullopt;
+  }
+  sockaddr_in remote{};
+  remote.sin_family = AF_INET;
+  remote.sin_port = htons(kDefaultRouteProbePort);
+  remote.sin_addr.s_addr = htonl(kDefaultRouteProbeIp);
+  // A UDP connect sends no packet; it only picks the route.
+  bool connected =
+      connect(sock, reinterpret_cast<const sockaddr*>(&remote), sizeof(remote)) == 0;
+  sockaddr_in local{};
+  socklen_t length = sizeof(local);
+  bool named =
+      connected && getsockname(sock, reinterpret_cast<sockaddr*>(&local), &length) == 0;
+  CloseProbeSocket(sock);
+  if (!named) {
+    return std::nullopt;
+  }
+  uint32_t ip = ntohl(local.sin_addr.s_addr);
+  if (ip == 0 || IsLoopbackIp(ip)) {
+    return std::nullopt;
+  }
+  return ip;
+}
